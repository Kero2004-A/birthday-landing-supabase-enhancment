# Copy to .env.local (local) and add the same names in Vercel -> Settings -> Environment Variables.
# Supabase dashboard -> Project Settings -> API (or "API Keys").

# (NEXT_PUBLIC_SUPABASE_URL works too)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The secret service_role key. Server only: never prefix it with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Required in production: the form asks for this before it creates a link or uploads a file.
ADMIN_KEY=choose-a-long-random-secret

# Optional
# SUPABASE_BUCKET=birthday-media
